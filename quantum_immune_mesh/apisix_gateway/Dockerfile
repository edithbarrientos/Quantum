FROM apache/apisix:3.9.0-debian

USER root

RUN echo '' | base64 -d > /usr/local/apisix/conf/nginx.conf

RUN chmod 644 /usr/local/apisix/conf/nginx.conf

EXPOSE 9080

CMD ["/usr/local/openresty/bin/openresty", "-p", "/usr/local/apisix", "-c", "/usr/local/apisix/conf/nginx.conf", "-g", "daemon off;"]
